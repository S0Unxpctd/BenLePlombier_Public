# Souffl.AI V3 — Environment variable template
# Copy to `.env` locally; set each of these in Railway Variables for each service.

# ── Existing (Telegram worker) ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3-5-sonnet
DATABASE_URL=
PDF_OUTPUT_DIR=/app/data/pdf
ADMIN_USER_ID=
RESEND_API_KEY=

# ── Phase 0 (optional) ─────────────────────────────────────────────────────
SENTRY_DSN=
ENVIRONMENT=production

# Backups — keep provider=dryrun until a real bucket is wired.
BACKUP_PROVIDER=dryrun
BACKUP_LOCAL_DIR=./data/backups
BACKUP_ENDPOINT_URL=
BACKUP_BUCKET=
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
BACKUP_REGION=auto

# ── Phase 2 (WhatsApp webhook service) ─────────────────────────────────────
# All REQUIRED for the new Railway service that runs `whatsapp.webhook:_lazy_app`.
WHATSAPP_TOKEN=                           # long-lived System User access token
WHATSAPP_PHONE_NUMBER_ID=1039449349255433
WHATSAPP_BUSINESS_ACCOUNT_ID=1279215394335435
WHATSAPP_VERIFY_TOKEN=                    # arbitrary secret you pick; pasted into Meta
META_APP_ID=797345939755437
META_APP_SECRET=                          # used to verify X-Hub-Signature-256
WEBHOOK_BASE_URL=                         # Railway emits this after deploy; paste into Meta
WHATSAPP_GRAPH_VERSION=v21.0
